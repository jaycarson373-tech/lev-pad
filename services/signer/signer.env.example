# Configure in the signing service's own secret manager, never public Vercel config.
SIGNER_ENABLE=
SIGNER_AUTH_TOKEN=
SIGNER_WALLET_ADDRESS=
SIGNER_ROLE=markets
SIGNER_MAX_LAMPORTS_PER_TX=
SIGNER_DAILY_LAMPORTS=
AWS_REGION=
KMS_KEY_ARN=
# Container packaging binds the HOST port to loopback only. An authenticated
# HTTPS reverse proxy and scoped IAM workload identity are still required.
# SIGNER_HOST_PORT=8787
# Use ambient IAM workload credentials. No wallet key/seed is read by this app.
# For a buybacks role only:
SIGNER_BUYBACK_ASSET=xSOL
SIGNER_BUYBACK_MAX_INPUT_BASE_UNITS=
SIGNER_BUYBACK_DAILY_INPUT_BASE_UNITS=
