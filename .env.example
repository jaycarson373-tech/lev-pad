# Optional private mainnet RPC endpoint. Used only by Vercel API functions.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Public configuration override. No keys/seeds/keypair fields are accepted.
# LEVERMEME_LAUNCH_CONFIG=<JSON matching config/launch.json>
# SWITCHBOARD_CROSSBAR_URL=<reviewed HTTPS provider origin>
# SWITCHBOARD_GATEWAY_URL=<explicit reviewed mainnet HTTPS gateway origin>
# SWITCHBOARD_FEED_PROTOS=<JSON mapping reviewed feed hashes to public job protobuf base64>
# JUPITER_API_KEY=<optional server-only routing API credential; never a wallet key>
#
# Optional keeper service (NOT a Vercel function; dry-run by default):
# KEEPER_WALLET_ADDRESS=<public wallet address>
# KEEPER_REMOTE_SIGNER_URL=<your independently secured HTTPS signer>
# KEEPER_MAX_LAMPORTS_PER_TX=<explicit conservative maximum>
# KEEPER_DAILY_LAMPORTS=<explicit daily budget>
# KEEPER_TASKS=markets
# Separate workers may use creator-fees or buybacks. Buybacks require:
# KEEPER_BUYBACK_ASSET=xSOL
# KEEPER_BUYBACK_MIN_INPUT_BASE_UNITS=<positive threshold>
# KEEPER_BUYBACK_MAX_INPUT_BASE_UNITS=<explicit per-action input cap>
# KEEPER_BUYBACK_DAILY_INPUT_BASE_UNITS=<explicit daily input cap>
# Store KEEPER_REMOTE_SIGNER_TOKEN only in the keeper's secret manager.
#
# Real token/program identities, secure deployment, funded acceptance and
# independent security/economic review are required before public funding.
