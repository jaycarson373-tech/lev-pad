# WEBSITE only: Vercel project levermeme > Settings > Environment Variables.
# Choose Production; redeploy after changes. Do not add a public/client prefix.
# Private project-specific mainnet RPC, used only by API functions.
SOLANA_RPC_URL=

# Public configuration override. No keys/seeds/keypair fields are accepted.
LEVERMEME_LAUNCH_CONFIG=
SWITCHBOARD_CROSSBAR_URL=
SWITCHBOARD_GATEWAY_URL=
# Optional replacement for Crossbar lookup: reviewed spot/TWAP job protobufs.
SWITCHBOARD_FEED_PROTOS=
# JUPITER_API_KEY=<optional server-only routing API credential; never a wallet key>
#
# Worker host: .env.keeper.example -> .env.keeper (NOT Vercel).
# Signing host: .env.signer.example -> .env.signer (NOT Vercel/browser).
# Check locally: node --env-file=.env.local scripts/check-env.mjs web
# Exact order and funding: START_HERE.md. Never add a wallet key/seed.
#
# Real token/program identities, secure deployment, funded acceptance and
# independent security/economic review are required before public funding.
