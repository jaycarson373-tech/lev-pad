# Copy to .env.keeper on the WORKER HOST, never into browser/public variables.
# All three services must use the same final public config/launch.json or JSON.
LEVERMEME_LAUNCH_CONFIG=
SOLANA_RPC_URL=
SWITCHBOARD_CROSSBAR_URL=
SWITCHBOARD_GATEWAY_URL=
SWITCHBOARD_FEED_PROTOS=

# Public address corresponding to the signing service's managed key, NOT admin.
KEEPER_WALLET_ADDRESS=
KEEPER_REMOTE_SIGNER_URL=
KEEPER_REMOTE_SIGNER_TOKEN=
KEEPER_TASKS=markets
KEEPER_INTERVAL_MS=2000
KEEPER_MODE_FLAG=--dry-run

# Operator-approved lamport budgets. Set after inspecting dry-run estimates.
# Both keeper and signer must enforce these (signer may be tighter).
# Daily counters reserve the WHOLE per-action cap for each signing attempt.
# daily / per-action = maximum signing attempts/day, including failed attempts.
KEEPER_MAX_LAMPORTS_PER_TX=
KEEPER_DAILY_LAMPORTS=

# Optional automatic revenue roles; unnecessary for the first market test.
# CREATOR_WALLET_ADDRESS=
# BUYBACK_WALLET_ADDRESS=
# KEEPER_BUYBACK_ASSET=xSOL
# KEEPER_BUYBACK_MIN_INPUT_BASE_UNITS=
# KEEPER_BUYBACK_MAX_INPUT_BASE_UNITS=
# KEEPER_BUYBACK_DAILY_INPUT_BASE_UNITS=
