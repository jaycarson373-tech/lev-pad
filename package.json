{
  "name": "levermeme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test scripts/mainnet-preflight.test.mjs tests/*.test.mjs",
    "build:onchain": "node scripts/build-onchain.mjs",
    "test:onchain": "NO_DNA=1 cargo test --locked --manifest-path onchain/Cargo.toml",
    "test:browser": "node scripts/browser-check.mjs",
    "codegen": "node scripts/codegen.mjs",
    "keeper": "node scripts/keeper.mjs",
    "setup": "node scripts/setup.mjs",
    "signer": "node services/signer/index.mjs",
    "check:release": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@solana-program/address-lookup-table": "0.16.0",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.5.0",
    "@solana/kit-plugin-wallet": "0.22.0"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.8.0",
    "codama": "1.11.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1"
  }
}
