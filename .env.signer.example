# Copy to .env.signer on the SIGNING HOST. Secret-manager input only.
LEVERMEME_LAUNCH_CONFIG=
SOLANA_RPC_URL=

# Explicit service startup opt-in. This does NOT broadcast transactions.
SIGNER_ENABLE=
# To start the reviewed service: I_ACCEPT_POLICY_BOUND_SIGNING
SIGNER_AUTH_TOKEN=
# Same secret as KEEPER_REMOTE_SIGNER_TOKEN; strong random token, >=32 characters.
SIGNER_WALLET_ADDRESS=
SIGNER_ROLE=markets
SIGNER_MAX_LAMPORTS_PER_TX=
SIGNER_DAILY_LAMPORTS=
AWS_REGION=
KMS_KEY_ARN=
# Use existing scoped IAM workload credentials, never a Solana private key.
# Bind KMS public identity to SIGNER_WALLET_ADDRESS; service checks it at startup.
SIGNER_HOST_PORT=8787

# Only for a separately deployed automatic buyback signer:
# SIGNER_BUYBACK_ASSET=xSOL
# SIGNER_BUYBACK_MAX_INPUT_BASE_UNITS=
# SIGNER_BUYBACK_DAILY_INPUT_BASE_UNITS=
